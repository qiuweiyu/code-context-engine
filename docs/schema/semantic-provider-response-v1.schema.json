{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-context-engine.dev/schema/semantic-provider-response-v1.schema.json",
  "title": "CCE Semantic Provider Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "request_id", "provider", "scores"],
  "properties": {
    "protocol": { "const": "cce.semantic-provider" },
    "version": { "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "semantic_score"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "semantic_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 512 },
      "default": []
    }
  }
}
